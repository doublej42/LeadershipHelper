# Copy this file to .env and fill in your values.
# Never commit .env to source control.

# SQL Server SA password — must meet SQL Server complexity requirements
# (min 8 chars, upper, lower, digit, symbol)
DB_SA_PASSWORD=Change_Me_Str0ng!

# Azure Communication Services connection string
# Found in the Azure portal under your ACS resource → Keys
ACS_CONNECTION_STRING=endpoint=https://YOUR_ACS_RESOURCE.communication.azure.com/;accesskey=YOUR_ACS_KEY

# Verified sender address configured in your ACS Email domain
ACS_EMAIL_FROM=DoNotReply@yourdomain.com

# Host port to expose the app on (default 8080)
APP_PORT=8080
