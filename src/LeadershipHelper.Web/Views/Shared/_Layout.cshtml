<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0f5132" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Leadership Helper" />
    <title>@ViewData["Title"] - Leadership Helper</title>
    <script type="importmap"></script>
    <link rel="icon" type="image/png" href="~/icons/icon-192.png" />
    <link rel="manifest" href="~/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="~/icons/apple-touch-icon.png" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/LeadershipHelper.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">Leadership Helper</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Situations" asp-action="Index">Browse Situations</a>
                        </li>
                        @* Mobile-only: user items merged into the main menu *@
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item d-sm-none"><hr class="my-1" /></li>
                            <li class="nav-item d-sm-none">
                                <span class="nav-link text-muted small fw-semibold">@User.Identity?.Name</span>
                            </li>
                            <li class="nav-item d-sm-none">
                                <a class="nav-link text-dark" asp-controller="Situations" asp-action="Mine">My Situations</a>
                            </li>
                            <li class="nav-item d-sm-none">
                                <a class="nav-link text-dark" asp-controller="Experiences" asp-action="Index">My Experiences</a>
                            </li>
                            <li class="nav-item d-sm-none">
                                <a class="nav-link text-dark" asp-controller="Situations" asp-action="Saved">Saved Situations</a>
                            </li>
                            <li class="nav-item d-sm-none">
                                <a class="nav-link text-dark" asp-controller="Account" asp-action="Index">Account</a>
                            </li>
                            <li class="nav-item d-sm-none">
                                <form method="post" asp-controller="Auth" asp-action="Logout">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-link nav-link text-danger p-0 ms-3">Sign out</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item d-sm-none">
                                <a class="nav-link text-dark" asp-controller="Auth" asp-action="Login">Sign in</a>
                            </li>
                        }
                    </ul>
                    @* Desktop-only: avatar dropdown / sign-in icon *@
                    <ul class="navbar-nav align-items-center d-none d-sm-flex">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                                var avatarName = User.Identity?.Name ?? "";
                                var avatarParts = avatarName.Trim().Split(' ', System.StringSplitOptions.RemoveEmptyEntries);
                                var initials = avatarParts.Length >= 2
                                    ? $"{avatarParts[0][0]}{avatarParts[^1][0]}"
                                    : (avatarParts.Length == 1 && avatarParts[0].Length > 0 ? $"{avatarParts[0][0]}" : "?");
                                initials = initials.ToUpper();
                                <li class="nav-item dropdown d-flex align-items-center">
                                <a class="nav-link dropdown-toggle p-1" href="#" role="button" data-bs-toggle="dropdown"
                                   aria-expanded="false" id="userMenuButton" aria-label="User menu">
                                    <span class="avatar-circle" aria-hidden="true">@initials</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userMenuButton">
                                    <li><h6 class="dropdown-header">@User.Identity?.Name</h6></li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li><a class="dropdown-item" asp-controller="Situations" asp-action="Mine">My Situations</a></li>
                                    <li><a class="dropdown-item" asp-controller="Experiences" asp-action="Index">My Experiences</a></li>
                                    <li><a class="dropdown-item" asp-controller="Situations" asp-action="Saved">Saved Situations</a></li>
                                    <li><a class="dropdown-item" asp-controller="Account" asp-action="Index">Account</a></li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <form method="post" asp-controller="Auth" asp-action="Logout">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item text-danger">Sign out</button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item me-2 d-flex align-items-center">
                                <button id="installAppButton" class="btn btn-success btn-sm my-1 d-none" type="button" aria-label="Install app">
                                    Install App
                                </button>
                            </li>
                            <li class="nav-item d-flex align-items-center">
                                <a class="nav-link p-1 text-dark" asp-controller="Auth" asp-action="Login" aria-label="Sign in">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                                        <path d="M11 6a3 3 0 1 1-6 0 3 3 0 0 1 6 0"/>
                                        <path fill-rule="evenodd" d="M0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8m8-7a7 7 0 0 0-5.468 11.37C3.242 11.226 4.805 10 8 10s4.757 1.225 5.468 2.37A7 7 0 0 0 8 1"/>
                                    </svg>
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Leadership Helper - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
