@model IReadOnlyList<LeadershipHelper.Web.Models.Situations.SituationListItemViewModel>
@{
    ViewData["Title"] = "Leadership Situations";
    var query = ViewData["Query"] as string;
}

<div class="mb-4 d-flex justify-content-between align-items-start flex-wrap gap-2">
    <div>
        <h1 class="h3">What leadership situation can I help you with?</h1>
        <p class="text-muted mb-0">Nothing you do in this app will be shared unless you share it.</p>
    </div>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <a asp-action="Create" class="btn btn-outline-primary btn-sm align-self-start">+ New situation</a>
    }
</div>

<form method="get" class="mb-4">
    <div class="input-group">
        <input id="q" name="q" value="@query" class="form-control" placeholder="Search by title or author&hellip;" aria-label="Search" />
        <button type="submit" class="btn btn-outline-secondary">Search</button>
    </div>
</form>

@if (!Model.Any())
{
    <p class="text-muted">No situations found.</p>
}
else
{
    <div class="list-group">
    @foreach (var item in Model)
    {
        <a asp-action="Details" asp-route-id="@item.Id"
           class="list-group-item list-group-item-action d-flex justify-content-between align-items-start py-3">
            <div class="me-auto">
                <div class="fw-semibold">@item.Title</div>
                <small class="text-muted">by @item.AuthorName</small>
            </div>
            <span class="badge bg-primary rounded-pill ms-2 align-self-center">@item.ActionCount prompts</span>
        </a>
    }
    </div>
}
