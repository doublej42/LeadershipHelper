@model IReadOnlyList<LeadershipHelper.Web.Models.Situations.SituationListItemViewModel>
@{
    ViewData["Title"] = "Saved situations";
}

<div class="mb-4">
    <a asp-action="Index" class="text-muted small">&larr; Browse all situations</a>
    <h1 class="h3 mt-2">Saved situations</h1>
    <p class="text-muted">Situations you&rsquo;ve bookmarked for later.</p>
</div>

@if (Model.Count == 0)
{
    <div class="text-center text-muted py-5">
        <p class="mb-2">You haven&rsquo;t saved any situations yet.</p>
        <a asp-action="Index" class="btn btn-outline-primary btn-sm">Browse situations</a>
    </div>
}
else
{
    <div class="list-group">
        @foreach (var item in Model)
        {
            <a asp-action="Details" asp-route-id="@item.Id"
               class="list-group-item list-group-item-action d-flex justify-content-between align-items-start py-3">
                <div class="me-auto">
                    <div class="fw-semibold">@item.Title</div>
                    <small class="text-muted">by @item.AuthorName</small>
                </div>
                <span class="badge bg-secondary rounded-pill ms-2 align-self-center">@item.ActionCount prompts</span>
            </a>
        }
    </div>
}
