@model LeadershipHelper.Web.Models.Situations.SituationInputModel
@{
    ViewData["Title"] = "Create situation";
}

<div class="mb-4">
    <a asp-action="Index" class="text-muted small">&larr; Back to situations</a>
    <h1 class="h3 mt-2">Create a new situation</h1>
</div>

<form method="post" asp-action="Create">
    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly" class="alert alert-danger d-none" id="val-summary"></div>

    <div class="card mb-3">
        <div class="card-body">
            <div class="mb-3">
                <label asp-for="Title" class="form-label fw-semibold">Title</label>
                <input asp-for="Title" class="form-control" placeholder="e.g. Dealing with a disengaged team member" />
                <span asp-validation-for="Title" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="ShortDescription" class="form-label fw-semibold">Short description</label>
                <textarea asp-for="ShortDescription" class="form-control" rows="2"
                          placeholder="A brief summary of when this situation applies"></textarea>
                <span asp-validation-for="ShortDescription" class="text-danger small"></span>
            </div>
            <div class="mb-0">
                <div class="mt-3 pt-3 border-top">
                <div class="form-check">
                    <input asp-for="IsCommunity" class="form-check-input" type="checkbox" />
                    <label asp-for="IsCommunity" class="form-check-label fw-semibold">Share with community</label>
                    <div class="form-text">If checked, this situation will appear in the public browse list.</div>
                </div>
            </div>
        </div>
    </div>

    <h5 class="fw-semibold mb-2">Actions</h5>
    <p class="text-muted small mb-3">These are the reflection actions that guide someone through the situation. Drag to reorder or just add them in order.</p>

    <div id="actions-list" class="list-group mb-3">
        @for (int i = 0; i < Model.Actions.Count; i++)
        {
            <div class="list-group-item py-3 action-row" draggable="true">
                <div class="d-flex align-items-start gap-2">
                    <span class="badge bg-secondary rounded-pill mt-2 step-badge">@(i + 1)</span>
                    <div class="flex-grow-1">
                        <textarea name="Actions[@i].PromptMarkdown" class="form-control mb-2"
                                  rows="2" placeholder="e.g. What have you already tried?">@Model.Actions[i].PromptMarkdown</textarea>
                        <div class="form-check">
                            <input type="checkbox" name="Actions[@i].RequiresTextResponse" value="true"
                                   class="form-check-input" id="req-@i"
                                   @(Model.Actions[i].RequiresTextResponse ? "checked" : "") />
                            <input type="hidden" name="Actions[@i].RequiresTextResponse" value="false" />
                            <label class="form-check-label small" for="req-@i">Requires written response</label>
                        </div>
                    </div>
                    <button type="button" class="btn btn-sm btn-outline-danger mt-1 remove-action">&#x2715;</button>
                </div>
            </div>
        }
    </div>

    <button type="button" class="btn btn-outline-secondary btn-sm mb-4" id="add-action">+ Add action</button>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">Create situation</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>

@section Scripts {
<script>
    const list = document.getElementById('actions-list');

    function renumber() {
        const rows = list.querySelectorAll('.action-row');
        rows.forEach((row, i) => {
            row.querySelector('.step-badge').textContent = i + 1;
            row.querySelector('textarea').name = `Actions[${i}].PromptMarkdown`;
            row.querySelectorAll('input[type=checkbox]').forEach(cb => cb.name = `Actions[${i}].RequiresTextResponse`);
            row.querySelectorAll('input[type=hidden]').forEach(h => h.name = `Actions[${i}].RequiresTextResponse`);
            const lbl = row.querySelector('label');
            if (lbl) { lbl.htmlFor = `req-${i}`; row.querySelector('input[type=checkbox]').id = `req-${i}`; }
        });
    }

    document.getElementById('add-action').addEventListener('click', () => {
        const i = list.querySelectorAll('.action-row').length;
        const div = document.createElement('div');
        div.className = 'list-group-item py-3 action-row';
        div.setAttribute('draggable', 'true');
        div.innerHTML = `
            <div class="d-flex align-items-start gap-2">
                <span class="badge bg-secondary rounded-pill mt-2 step-badge">${i + 1}</span>
                <div class="flex-grow-1">
                    <textarea name="Actions[${i}].PromptMarkdown" class="form-control mb-2" rows="2" placeholder="e.g. What have you already tried?"></textarea>
                    <div class="form-check">
                        <input type="checkbox" name="Actions[${i}].RequiresTextResponse" value="true" class="form-check-input" id="req-${i}" />
                        <input type="hidden" name="Actions[${i}].RequiresTextResponse" value="false" />
                        <label class="form-check-label small" for="req-${i}">Requires written response</label>
                    </div>
                </div>
                <button type="button" class="btn btn-sm btn-outline-danger mt-1 remove-action">&#x2715;</button>
            </div>`;
        list.appendChild(div);
        div.querySelector('textarea').focus();
        renumber();
    });

    list.addEventListener('click', e => {
        if (e.target.closest('.remove-action')) {
            e.target.closest('.action-row').remove();
            renumber();
        }
    });

    // HTML5 drag/drop reordering for action rows.
    let draggingRow = null;

    list.addEventListener('dragstart', e => {
        const row = e.target.closest('.action-row');
        if (!row) return;
        draggingRow = row;
        row.classList.add('opacity-50');
        e.dataTransfer.effectAllowed = 'move';
    });

    list.addEventListener('dragend', () => {
        if (draggingRow) {
            draggingRow.classList.remove('opacity-50');
            draggingRow = null;
        }
    });

    list.addEventListener('dragover', e => {
        if (!draggingRow) return;
        e.preventDefault();

        const target = e.target.closest('.action-row');
        if (!target || target === draggingRow) return;

        const rect = target.getBoundingClientRect();
        const before = e.clientY < rect.top + rect.height / 2;
        if (before) {
            list.insertBefore(draggingRow, target);
        } else {
            list.insertBefore(draggingRow, target.nextSibling);
        }
    });

    list.addEventListener('drop', e => {
        if (!draggingRow) return;
        e.preventDefault();
        renumber();
    });

    // Show validation summary if it has content
    const vs = document.getElementById('val-summary');
    if (vs && vs.querySelectorAll('li').length) vs.classList.remove('d-none');
</script>
}
